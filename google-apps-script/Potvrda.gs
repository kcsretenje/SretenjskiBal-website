/**
 * Sadržaj potvrde (bez crtanja) — da bi mogao da se proveri testovima.
 * r: red rezervacije; tickets: iz issueTickets_ (svaki ima .type); paidAt: Date.
 */
function paymentReceiptData_(r, settings, lang, paidAt, tickets, now) {
  const L = RECEIPT_TEXT[lang] || RECEIPT_TEXT.sr;
  const tz = sheetTimeZone_();
  const n = String(r.number).trim();
  const amount = Number(r.amount) || 0;
  const money = function (v) { return formatAmount_(v, settings.currency, lang); };
  const date = function (d) { return Utilities.formatDate(d, tz, L.dateFormat); };

  // Stavke po tipu karte; ako cene iz podešavanja ne daju upisani iznos, jedna stavka sa ukupnim iznosom.
  const counts = {};
  const order = [];
  (tickets || []).forEach(function (t) {
    const type = String(t.type || '').trim();
    if (!(type in counts)) { counts[type] = 0; order.push(type); }
    counts[type]++;
  });
  const total = (tickets || []).length || parseInt(r.ticketCount, 10) || 0;
  const priceOf = function (type) {
    const code = Object.keys(TICKET_TYPES).filter(function (c) { return TICKET_TYPES[c] === type; })[0];
    return code ? Number(settings.prices[code]) || 0 : 0;
  };
  let lines = order.map(function (type) {
    const p = priceOf(type);
    return { desc: (L.types[type] || type) + ' — ' + L.event, qty: counts[type], unit: p, sum: p * counts[type] };
  });
  const sum = lines.reduce(function (s, l) { return s + l.sum; }, 0);
  if (!lines.length || lines.some(function (l) { return !l.unit; }) || Math.abs(sum - amount) > 0.005) {
    lines = [{ desc: (order.length === 1 ? (L.types[order[0]] || order[0]) : L.tickets) + ' — ' + L.event, qty: total, unit: null, sum: amount }];
    if (order.length === 1 && total > 0) lines[0].unit = amount / total;
  }

  // Uplatilac: firma (ako je tražena faktura na firmu) ili kontakt osoba.
  const company = companyFields_(r.company);
  const person = String(r.fullName || '').trim();
  const email = String(r.email || '').trim();
  const payer = company.name
    ? {
      name: company.name,
      lines: [company.address, company.country, company.taxId ? L.taxId + ': ' + company.taxId : '', L.contact + ': ' + person, email]
        .filter(Boolean),
    }
    : { name: person, lines: [email].filter(Boolean) };

  const method = String(r.paymentMethod || '').trim();
  const info = [[L.reservation, n], [L.paidAt, date(paidAt)]];
  if (method) info.push([L.method, L.methods[method] || method]);
  if (method === 'Na račun' && settings.iban) info.push([L.iban, settings.iban]);
  info.push([L.issued, date(now || new Date())]);

  return {
    L: L,
    number: n,
    payer: payer,
    lines: lines.map(function (l) {
      return { desc: l.desc, qty: String(l.qty), unit: l.unit == null ? '' : money(l.unit), sum: money(l.sum) };
    }),
    total: money(amount),
    info: info,
    fileName: L.file + ' ' + n + '.pdf',
  };
}

/** „Naziv: X\nSedež: Y\nDržava: Z\nPoreski broj: W" (iz buildRecord_) → polja; ručno upisan tekst → samo naziv. */
function companyFields_(text) {
  const rows = String(text || '').split('\n').map(function (s) { return s.trim(); }).filter(Boolean);
  const out = { name: '', address: '', country: '', taxId: '' };
  const keys = { Naziv: 'name', 'Sedež': 'address', 'Država': 'country', 'Davčna številka': 'taxId', 'Poreski broj': 'taxId' };
  rows.forEach(function (row, i) {
    const m = row.match(/^([^:]+):\s*(.*)$/);
    const key = m && keys[m[1].trim()];
    if (key) out[key] = m[2].trim();
    else if (i === 0 && !out.name) out.name = row;
    else out.address = out.address ? out.address + ', ' + row : row;
  });
  return out;
}

// ── Crtanje (A4 = 595,3 × 841,9 pt; mere prenete sa odobrenog probnog izgleda) ──────────────────

const RECEIPT_W = 595.3;
const RECEIPT_X = 48; // levi rub teksta
const RECEIPT_R = 547.5; // desni rub teksta
const RECEIPT_TEXT_COLOR = '#3d3531';
const RECEIPT_RULE = '#d8ccb6';
const RECEIPT_RULE_SOFT = '#ece4d6';
const RECEIPT_BRASS_DARK = '#7a6438';
const RECEIPT_INSET = 7.2; // unutrašnji razmak tekstualnog okvira u Slides-u
const RECEIPT_TEMPLATE_PROP = 'RECEIPT_TEMPLATE_ID';
const RECEIPT_TEMPLATE_NAME = 'Sretenjski bal — šablon potvrde o uplati (ne brisati)';

function paymentReceiptPdf_(r, settings, lang, paidAt, tickets) {
  const d = paymentReceiptData_(r, settings, lang, paidAt, tickets);
  const L = d.L;
  const id = DriveApp.getFileById(slidesTemplateId_(RECEIPT_TEMPLATE_PROP, RECEIPT_TEMPLATE_NAME, RECEIPT_TEMPLATE_PPTX_BASE64))
    .makeCopy('Potvrda o uplati ' + d.number + ' (privremeno)').getId();
  try {
    const deck = SlidesApp.openById(id);
    const slide = deck.getSlides()[0] || deck.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    slide.getPageElements().forEach(function (e) { e.remove(); });
    slide.getBackground().setSolidFill('#ffffff');

    // Zaglavlje: bordo traka sa SB logom (slika), naslov, vrsta dokumenta i broj
    slide.insertImage(receiptHeader_()).setLeft(0).setTop(0).setWidth(RECEIPT_W).setHeight(112.5);
    const text = function (s, x, cy, w, size, font, weight, color, align) {
      return receiptText_(slide, s, x, cy, w, size, font, weight, color, align);
    };
    text('Sretenjski bal', 136.6, 50.3, 300, 25.5, 'Playfair Display', 400, TICKET_PDF_IVORY);
    text(spaced_(L.title), 136.6, 74.3, 300, 7.5, 'Manrope', 500, TICKET_PDF_BRASS);
    text(spaced_(L.no), RECEIPT_R - 150, 48.8, 150, 7.5, 'Manrope', 500, TICKET_PDF_BRASS, 'right');
    text(d.number, RECEIPT_R - 150, 68.3, 150, 19.5, 'Manrope', 300, TICKET_PDF_IVORY, 'right');

    // Organizator | Uplatilac
    const colW = 234.8;
    const col2 = 312.8;
    const label = function (s, x, y, w, color) {
      text(spaced_(s), x, y + 3.6, w, 7.1, 'Manrope', 500, color || TICKET_PDF_WINE);
    };
    const rule = function (x1, y, x2, color) { receiptLine_(slide, x1, y, x2, color || RECEIPT_RULE); };
    label(L.organizer, RECEIPT_X, 142.5, colW);
    rule(RECEIPT_X, 156.4, RECEIPT_X + colW);
    label(L.payer, col2, 142.5, colW);
    rule(col2, 156.4, col2 + colW);
    const block = function (x, name, lines) {
      text(name, x, 173.2, colW, name.length > 42 ? 10.5 : 12, 'Playfair Display', 400, TICKET_PDF_INK);
      lines.forEach(function (s, i) { text(s, x, 191.1 + i * 14.1, colW, 9.4, 'Manrope', 400, RECEIPT_TEXT_COLOR); });
      return 184 + lines.length * 14.1;
    };
    const bottom = Math.max(block(RECEIPT_X, RECEIPT_ORGANIZER, L.org), block(col2, d.payer.name, d.payer.lines));

    // Predmet uplate: tabela
    let y = bottom + 25.4;
    label(L.subject, RECEIPT_X, y, 300);
    y += 17.6;
    const cols = [[RECEIPT_X, 312, 'left'], [360, 58, 'right'], [418, 55.1, 'right'], [473.1, 74.4, 'right']];
    L.cols.forEach(function (c, i) {
      text(spaced_(c), cols[i][0], y + 3.6, cols[i][1], 7.1, 'Manrope', 500, RECEIPT_BRASS_DARK, cols[i][2]);
    });
    y += 15;
    rule(RECEIPT_X, y, RECEIPT_R);
    d.lines.forEach(function (l) {
      [l.desc, l.qty, l.unit, l.sum].forEach(function (s, i) {
        if (s) text(s, cols[i][0], y + 16.4, cols[i][1], 9.4, 'Manrope', 400, TICKET_PDF_INK, cols[i][2]);
      });
      y += 32.8;
      rule(RECEIPT_X, y, RECEIPT_R, RECEIPT_RULE_SOFT);
    });
    text(spaced_(L.total), RECEIPT_X, y + 19.5, 300, 7.5, 'Manrope', 500, TICKET_PDF_INK);
    text(d.total, 323, y + 19.5, 224.5, 15, 'Manrope', 300, TICKET_PDF_WINE, 'right');

    // Podaci o uplati
    y += 61.8;
    d.info.forEach(function (row, i) {
      text(row[0], RECEIPT_X, y + 7 + i * 20.8, 150, 9.4, 'Manrope', 400, TICKET_PDF_SOFT);
      text(row[1], 198, y + 7 + i * 20.8, 349.5, 9.4, 'Manrope', 400, TICKET_PDF_INK);
    });

    // Podnožje
    rule(RECEIPT_X, 790.5, RECEIPT_R);
    text('Kulturni centar Sretenje · info@kcsretenje.si · sretenjskibal.si', RECEIPT_X, 810.8, 400, 7.5, 'Manrope', 400, TICKET_PDF_SOFT);

    deck.saveAndClose();
    return DriveApp.getFileById(id).getAs('application/pdf').setName(d.fileName);
  } finally {
    try {
      DriveApp.getFileById(id).setTrashed(true);
    } catch (err) {
      console.error('Privremena prezentacija ' + id + ' nije obrisana: ' + err.message);
    }
  }
}

/** Tekst u jednom redu: x = levi rub teksta, cy = sredina reda (pt od vrha), w = širina, align left|right. */
function receiptText_(slide, s, x, cy, w, size, font, weight, color, align) {
  const h = Math.max(20, size * 2);
  const box = slide.insertTextBox(String(s), x - RECEIPT_INSET, cy - h / 2, w + 2 * RECEIPT_INSET, h);
  box.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);
  const range = box.getText();
  range.getParagraphStyle()
    .setParagraphAlignment(align === 'right' ? SlidesApp.ParagraphAlignment.END : SlidesApp.ParagraphAlignment.START)
    .setSpaceAbove(0)
    .setSpaceBelow(0)
    .setLineSpacing(100);
  range.getTextStyle()
    .setFontFamilyAndWeight(font, weight)
    .setFontSize(size)
    .setForegroundColor(color);
  return box;
}

function receiptLine_(slide, x1, y, x2, color) {
  const line = slide.insertLine(SlidesApp.LineCategory.STRAIGHT, x1, y, x2, y);
  line.setWeight(0.75);
  line.getLineFill().setSolidFill(color);
  return line;
}

function receiptHeader_() {
  return Utilities.newBlob(Utilities.base64Decode(RECEIPT_HEADER_JPEG_BASE64), 'image/jpeg', 'potvrda-zaglavlje.jpg');
}

/** Meni: probna potvrda o uplati (izmišljeni podaci) na adresu organizatora. */
function menuTestReceiptPdf() {
  const ui = SpreadsheetApp.getUi();
  const s = readSettings_();
  try {
    const sample = {
      number: '0000', fullName: 'Ana Petrović', email: 'ana.petrovic@example.com', ticketCount: 2,
      amount: (Number(s.prices.SVECANA) || 140) * 2, paymentMethod: 'Na račun', company: '',
    };
    const tickets = [{ type: TICKET_TYPES.SVECANA }, { type: TICKET_TYPES.SVECANA }];
    const pdf = paymentReceiptPdf_(sample, s, RECEIPT_LANG, new Date(), tickets);
    sendMail_(s, {
      to: s.adminEmail,
      subject: 'Sretenjski bal — probna potvrda o uplati',
      body: 'U prilogu je probna potvrda o uplati (izmišljeni podaci).',
      attachments: [pdf],
    });
    ui.alert('Probna potvrda o uplati je poslata na ' + s.adminEmail + '.');
  } catch (err) {
    ui.alert('Probna potvrda o uplati NIJE napravljena: ' + err.message);
  }
}

