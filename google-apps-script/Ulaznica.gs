/**
 * PDF ulaznice — po jedna za svakog gosta, u prilogu mejla „potvrda uplate" (uz QR kodove u samom mejlu).
 *
 * Kako radi: za svaku ulaznicu skripta napravi privremenu Google Slides prezentaciju veličine 5,625 × 10 in
 * (uspravno), na nju stavi pozadinu (bordo deo sa logom i papir), tekst i QR kod, sačuva je kao PDF
 * i odmah je pošalje u Otpad na Drajvu. Ako nešto pođe naopako, mejl sa QR kodovima ipak odlazi, samo bez PDF-a.
 *
 * Potrebno jednom: u Apps Script editoru → Services (+) → Google Slides API → Add (identifikator „Slides").
 * Probni PDF: meni „Sretenjski bal" → „Pošalji probnu PDF ulaznicu organizatoru".
 */

const TICKET_PDF_W = 405; // pt (5,625 in)
const TICKET_PDF_H = 720; // pt (10 in)

const TICKET_PDF_TEXT = {
  sr: {
    title: 'Sretenjski bal', dateLabel: 'Datum', date: 'Subota, 13. februar 2027.', placeLabel: 'Mesto', place: 'Narodni dom Maribor',
    kicker: 'Ulaznica', types: { Svečana: 'Svečana ulaznica', Galerija: 'Ulaznica za galeriju' },
    of: 'od', reservation: 'rezervacija', show: 'Pokažite QR kod na ulazu.', file: 'Ulaznica',
  },
  sl: {
    title: 'Sretenjski bal', dateLabel: 'Datum', date: 'Sobota, 13. februar 2027', placeLabel: 'Kraj', place: 'Narodni dom Maribor',
    kicker: 'Vstopnica', types: { Svečana: 'Svečana vstopnica', Galerija: 'Vstopnica za galerijo' },
    of: 'od', reservation: 'rezervacija', show: 'Na vhodu pokažite QR kodo.', file: 'Vstopnica',
  },
  en: {
    title: 'Sretenjski bal', dateLabel: 'Date', date: 'Saturday, 13 February 2027', placeLabel: 'Venue', place: 'Narodni dom Maribor',
    kicker: 'Ticket', types: { Svečana: 'Gala ticket', Galerija: 'Gallery ticket' },
    of: 'of', reservation: 'reservation', show: 'Show the QR code at the entrance.', file: 'Ticket',
  },
};

// Boje i fontovi kao na sajtu.
const TICKET_PDF_IVORY = '#f6f1e8';
const TICKET_PDF_BRASS = '#b49a63';
const TICKET_PDF_WINE = '#5a1723';
const TICKET_PDF_INK = '#171413';
const TICKET_PDF_SOFT = '#5b4f48';

/** PDF ulaznice za sve goste rezervacije (niz blobova, istim redom kao ulaznice). */
function ticketPdfs_(tickets, lang) {
  return tickets.map(function (t) { return ticketPdf_(t, lang); });
}

/** Jedna PDF ulaznica. t: { index, count, number, code, name, type } iz issueTickets_. */
function ticketPdf_(t, lang) {
  const L = TICKET_PDF_TEXT[lang] || TICKET_PDF_TEXT.sr;
  const created = Slides.Presentations.create({
    title: 'Ulaznica ' + t.code + ' (privremeno)',
    pageSize: { width: { magnitude: TICKET_PDF_W, unit: 'PT' }, height: { magnitude: TICKET_PDF_H, unit: 'PT' } },
  });
  const id = created.presentationId;
  try {
    const deck = SlidesApp.openById(id);
    const slide = deck.getSlides()[0] || deck.appendSlide(SlidesApp.PredefinedLayout.BLANK);
    slide.getPageElements().forEach(function (e) { e.remove(); });
    slide.getBackground().setPictureFill(ticketPdfBackground_());

    const type = ticketPdfType_(t.type, L);
    const name = String(t.name || '').trim();
    // tekst, centar reda (pt od vrha), visina okvira, veličina slova, font, debljina, boja
    ticketPdfText_(slide, L.title, 165.8, 64, 43.5, 'Playfair Display', 400, TICKET_PDF_IVORY);
    ticketPdfText_(slide, spaced_(L.dateLabel), 237.7, 30, 7.1, 'Manrope', 500, TICKET_PDF_BRASS);
    ticketPdfText_(slide, L.date, 256.1, 32, 13.5, 'Playfair Display', 400, TICKET_PDF_IVORY);
    ticketPdfText_(slide, spaced_(L.placeLabel), 284.9, 30, 7.1, 'Manrope', 500, TICKET_PDF_BRASS);
    ticketPdfText_(slide, L.place, 303.2, 32, 13.5, 'Playfair Display', 400, TICKET_PDF_IVORY);
    ticketPdfText_(slide, spaced_(L.kicker), 390.2, 30, 7.9, 'Manrope', 500, TICKET_PDF_WINE);
    if (type) ticketPdfText_(slide, type, 409.5, 32, 12.75, 'Playfair Display', 400, TICKET_PDF_WINE);
    ticketPdfText_(slide, name, 440.2, 40, name.length > 28 ? 15 : 18.75, 'Playfair Display', 400, TICKET_PDF_INK);
    ticketPdfText_(slide, t.code, 630.6, 30, 8.25, 'Manrope', 500, TICKET_PDF_SOFT);
    ticketPdfText_(
      slide,
      L.kicker + ' ' + t.index + ' ' + L.of + ' ' + t.count + ' · ' + L.reservation + ' ' + t.number + '\n' + L.show,
      680.3, 40, 7.5, 'Manrope', 400, TICKET_PDF_SOFT,
    );

    // QR unutar belog kvadrata sa pozadine (kvadrat 150 pt, QR 132 pt)
    const qr = slide.insertImage(ticketPdfQrBlob_(t.code));
    qr.setLeft(136.5).setTop(476.5).setWidth(132).setHeight(132);

    deck.saveAndClose();
    const fileName = L.file + ' ' + t.index + ' - ' + ticketPdfFileName_(name) + '.pdf';
    return DriveApp.getFileById(id).getAs('application/pdf').setName(fileName);
  } finally {
    try {
      DriveApp.getFileById(id).setTrashed(true);
    } catch (err) {
      console.error('Privremena prezentacija ' + id + ' nije obrisana: ' + err.message);
    }
  }
}

function ticketPdfText_(slide, text, centerY, height, size, font, weight, color) {
  const box = slide.insertTextBox(String(text), 20, centerY - height / 2, TICKET_PDF_W - 40, height);
  box.setContentAlignment(SlidesApp.ContentAlignment.MIDDLE);
  const range = box.getText();
  range.getParagraphStyle()
    .setParagraphAlignment(SlidesApp.ParagraphAlignment.CENTER)
    .setSpaceAbove(0)
    .setSpaceBelow(0)
    .setLineSpacing(115);
  range.getTextStyle()
    .setFontFamilyAndWeight(font, weight)
    .setFontSize(size)
    .setForegroundColor(color);
  return box;
}

/** „Datum" → „D A T U M" (Slides nema razmak između slova, pa ga pravimo uskim razmacima). */
function spaced_(s) {
  return String(s).toUpperCase().split('').join(' ');
}

/** „Svečana" → „Svečana ulaznica" (i prevodi); nepoznat tip ostaje kakav jeste. */
function ticketPdfType_(type, L) {
  const s = String(type || '').trim();
  return L.types[s] || s;
}

function ticketPdfFileName_(name) {
  return String(name || '').replace(/[\\/:*?"<>|·]+/g, ' ').replace(/\s+/g, ' ').trim() || 'gost';
}

/** QR kod za PDF: krupniji moduli i bez belog ruba (beli kvadrat je već na pozadini). */
function ticketPdfQrBlob_(code) {
  const qr = qrcode(0, 'M');
  qr.addData(TICKET_QR_PREFIX + code);
  qr.make();
  const dataUrl = qr.createDataURL(12, 0);
  return Utilities.newBlob(Utilities.base64Decode(dataUrl.split(',')[1]), 'image/gif', 'qr-' + code + '.gif');
}

/** Pozadina ulaznice: bordo deo sa okvirom i SB logom, perforacija i papir sa belim poljem za QR (JPEG 1080×1920). */
function ticketPdfBackground_() {
  return Utilities.newBlob(Utilities.base64Decode(TICKET_PDF_BACKGROUND_JPEG_BASE64), 'image/jpeg', 'ulaznica-pozadina.jpg');
}

/** Meni: napravi probnu PDF ulaznicu i pošalji je organizatoru (kod na njoj nije prava ulaznica). */
function menuTestTicketPdf() {
  const ui = SpreadsheetApp.getUi();
  const s = readSettings_();
  try {
    const sample = { index: 1, count: 2, number: '0000', code: '0000-1-PROBA000', name: 'Ana Petrović', type: TICKET_TYPES.SVECANA };
    const pdf = ticketPdf_(sample, 'sr');
    sendMail_(s, {
      to: s.adminEmail,
      subject: 'Sretenjski bal — probna PDF ulaznica',
      body: 'U prilogu je probna PDF ulaznica (izmišljeno ime i kod, nije prava ulaznica).',
      attachments: [pdf],
    });
    ui.alert('Probna PDF ulaznica je poslata na ' + s.adminEmail + '.');
  } catch (err) {
    ui.alert(
      'Probna PDF ulaznica NIJE napravljena: ' + err.message +
      (/Slides is not defined/.test(err.message)
        ? '\n\nDodajte Google Slides API: u Apps Script editoru → Services (+) → Google Slides API → Add.'
        : ''),
    );
  }
}

const TICKET_PDF_BACKGROUND_JPEG_BASE64 = '';
